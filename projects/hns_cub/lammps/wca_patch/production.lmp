# HnsCub, variant wca_patch: a DNA ring with H-NS proteins among crowders
# in a periodic cube, in Lennard-Jones units, with a Langevin thermostat.
# Every pair potential is the 12-6 Lennard-Jones potential, shifted to zero
# at its cutoff. The cutoff is at the potential's minimum, 2^(1/6) sigma_ij,
# for every pair but two: the DNA monomer and H-NS pole pair, which is cut
# beyond its minimum and so attracts, and the two pairs that no pair_coeff
# sets (pole and core, pole and crowder), whose coefficients LAMMPS mixes.
#
# This input reads the relaxed ring that minimize.lmp wrote in the run's
# folder, adds the H-NS proteins and the crowders, equilibrates for
# 2e5 steps with the DNA-pole attraction weak, then runs 10 production
# loops of 1e7 steps with it strong.
#
# The run's folder holds this file as input.lmp (the production loop jumps
# back into it by that name), minimized.dna.data, hns.mol, and an empty
# restarts/ folder. The sweep generator writes the run's variables at the
# top of input.lmp, from its row of SWEEP in study.conf:
#   N, kBend11, n_hns, sig4, eps34, n_crowd, l, i, randseed, neigh_style
#
# Atom types: 1 DNA monomer, 2 H-NS pole, 3 H-NS core, 4 crowder.
# Bond types: 1 DNA-DNA (FENE), 2 pole-core (harmonic).
# Angle types: 1 DNA-DNA-DNA, 2 pole-core-pole.

#---------- Run lengths ----------
# Index variables holding the production values. A test shortens them
# with -var on the command line (for example -var loop_steps 1000);
# LAMMPS never redefines an index variable. The loop pads j to the width
# of n_loops: 10 loops give j01, j02, ..., j10.
variable eq_steps index 200000
variable n_loops index 10
variable loop_steps index 10000000
variable restart_every index 100000

# The run's name, which its output files carry.
variable simname string N${N}kbmm${kBend11}nh${n_hns}ac${sig4}l${l}epshc${eps34}nc${n_crowd}ens${i}

#---------- Sizes ----------
# sig1 DNA monomer, sig2 H-NS pole, sig3 H-NS core, sig4 crowder (from the
# row); a crowder's mass is sig4^3.
variable m_crowd equal ${sig4}^3
# ljRcut = 2^(1/6), rounded at the sixth decimal place.
variable ljRcut equal 1.122462
variable sig1 equal 1.0
variable sig2 equal 0.178
variable sig3 equal 1.0

#---------- sigma_ij ----------
# sigma_ij = (sigma_i + sigma_j) / 2, but for the DNA-pole pair. The poles
# sit 0.4 sig1 from the core's center, so a monomer touching the core along
# the poles' axis is 0.6 sig1 from the nearer pole: sig12 = 0.6 / ljRcut.
variable sig11 equal 0.5*(${sig1}+${sig1})
variable sig12 equal 0.535
variable sig13 equal 0.5*(${sig1}+${sig3})
variable sig14 equal 0.5*(${sig1}+${sig4})
variable sig22 equal 0.5*(${sig2}+${sig2})
variable sig33 equal 0.5*(${sig3}+${sig3})
variable sig34 equal 0.5*(${sig3}+${sig4})
variable sig44 equal 0.5*(${sig4}+${sig4})

#---------- Cutoffs ----------
# ljRcut sigma_ij, but for the DNA-pole pair, cut at sig12 + 0.15 sig1, and
# the pole-pole pair, cut at 0.2.
variable cutoff11 equal ${sig11}*${ljRcut}
variable cutoff12 equal 0.685
variable cutoff13 equal ${sig13}*${ljRcut}
variable cutoff14 equal ${sig14}*${ljRcut}
variable cutoff22 equal 0.2
variable cutoff33 equal ${sig33}*${ljRcut}
variable cutoff34 equal ${sig34}*${ljRcut}
variable cutoff44 equal ${sig44}*${ljRcut}

#---------- epsilon_ij ----------
# The DNA-pole strength is 1 in the equilibration and 29 in production;
# the core-crowder strength is the row's eps34.
variable epsilon11 equal 1.0
variable epsilon12equilbrate equal 1.0
variable epsilon12 equal 29.0
variable epsilon13 equal 1.0
variable epsilon14 equal 1.0
variable epsilon22 equal 1.0
variable epsilon33 equal 1.0
variable epsilon34 equal ${eps34}
variable epsilon44 equal 1.0

#---------- Bond constants ----------
# FENE for DNA-DNA: R0 = 1.5 sigma_11 and K = 30 epsilon_11 / sigma_11^2.
variable rBondFene11 equal 1.5*${sig11}
variable kFene11 equal 30*${epsilon11}/(${sig11}^2)
# Harmonic for pole-core: r0 = 0.4 and K = 120.
variable rBondHarm23 equal 0.4
variable kHarm23 equal 120.0

#---------- Initialization ----------
units lj
dimension 3
boundary p p p
atom_style angle

# The relaxed ring, with room for the types of the proteins and crowders.
read_data minimized.dna.data nocoeff extra/atom/types 3 extra/bond/types 1 &
    extra/angle/types 1

#---------- Neighbor lists ----------
# The run's row names the style. bin: one bin size for all atom types.
# multi: two collections, the DNA and H-NS types (1 to 3) and the
# crowders (4), each with its own bin size and ghost cutoff, the largest
# pair cutoff in it plus the skin.
variable vskin equal 0.3
neighbor ${vskin} ${neigh_style}
neigh_modify delay 0 every 1 check yes
variable gRcut1 equal ${cutoff11}+${vskin}
variable gRcut4 equal ${cutoff44}+${vskin}
if "${neigh_style} == multi" then &
    "neigh_modify collection/type 2 1*3 4" &
    "comm_modify mode multi cutoff/multi 1 ${gRcut1} cutoff/multi 2 ${gRcut4}"

#---------- Cube ----------
# The periodic cube of side 2 l, centered at the origin.
change_box all x final -${l} ${l} y final -${l} ${l} z final -${l} ${l} &
    boundary p p p units box
region cube block INF INF INF INF INF INF units box

#---------- H-NS proteins and crowders ----------
# Each H-NS protein is the molecule of hns.mol: a core (type 3) and two
# poles (type 2) on an axis, 0.4 from it, held by two harmonic bonds and
# one angle. The proteins, at random orientations, and then the crowders
# are placed at random in the cube.
molecule 2 hns.mol toff 1 boff 1 aoff 1
variable randseed_mols equal ${randseed}+1
variable randseed_hns equal ${randseed}+2
variable randseed_crowds equal ${randseed}+3
create_atoms 0 random ${n_hns} ${randseed_mols} cube units box mol 2 ${randseed_hns}
create_atoms 4 random ${n_crowd} ${randseed_crowds} cube units box

mass 1 1.0
mass 2 1.0
mass 3 1.0
mass 4 ${m_crowd}

group dna type 1
group hns_pole type 2
group hns_core type 3
group crowder type 4
group nucleoid type 1 2 3

compute mobile all temp
velocity all create 1.0 ${randseed} temp mobile

#---------- Pair potential ----------
# lj/cut with epsilon_ij, sigma_ij, and the cutoffs above, shifted to zero
# at the cutoff. Pole-core (2 3) and pole-crowder (2 4) have no pair_coeff:
# LAMMPS mixes their coefficients from those of 2 2, 3 3, and 4 4, by the
# geometric rule of pair_modify.
pair_style lj/cut ${ljRcut}
pair_modify shift yes
pair_coeff 1 1 ${epsilon11} ${sig11} ${cutoff11}
pair_coeff 1 2 ${epsilon12equilbrate} ${sig12} ${cutoff12}
pair_coeff 1 3 ${epsilon13} ${sig13} ${cutoff13}
pair_coeff 1 4 ${epsilon14} ${sig14} ${cutoff14}
pair_coeff 2 2 ${epsilon22} ${sig22} ${cutoff22}
pair_coeff 3 3 ${epsilon33} ${sig33} ${cutoff33}
pair_coeff 3 4 ${epsilon34} ${sig34} ${cutoff34}
pair_coeff 4 4 ${epsilon44} ${sig44} ${cutoff44}

#---------- Bonds ----------
# special_bonds fene turns the pair potential off between bonded atoms.
bond_style hybrid fene harmonic
special_bonds fene
bond_coeff 1 fene ${kFene11} ${rBondFene11} ${epsilon11} ${sig11}
bond_coeff 2 harmonic ${kHarm23} ${rBondHarm23}

#---------- Angles ----------
# U = K (theta - 180)^2. For the DNA, K = kBend11 / 2: LAMMPS's harmonic
# angle has no factor 1/2, so the bending rigidity of the row, kBend11, is
# halved. For the pole-core-pole angle, K = 50.
angle_style harmonic
variable kBend11Lammps equal 0.5*${kBend11}
angle_coeff 1 ${kBend11Lammps} 180.0
angle_coeff 2 50.0 180.0

thermo 10000
thermo_style custom step ke pe etail ecouple econserve evdwl ebond eangle &
    emol temp press

#---------- Equilibration ----------
# eq_steps steps (2e5) at dt 0.01 with displacements capped at 0.01 per
# step. Langevin thermostat at T = 1 with damping time 1; for the
# crowders, the damping time is multiplied by m_crowd / sig4. The ring's
# center of mass is kept at the origin.
variable scale4 equal ${m_crowd}/${sig4}
fix F_langevin all langevin 1 1 1 ${randseed} scale 4 ${scale4} tally yes
fix F_nve all nve/limit 0.01
fix F_recenter dna recenter 0.0 0.0 0.0 shift all units box
timestep 0.01
run ${eq_steps}
write_restart ./restart.before.i${i}.part2.all_no_hns_attraction
unfix F_langevin
unfix F_nve
unfix F_recenter

#---------- Production ----------
# The DNA-pole strength becomes epsilon12, 29. n_loops loops of loop_steps
# steps at dt 0.005. The DNA and H-NS proteins are written every 5000 steps
# to one file; all particles every 10000 steps, to one gzipped file per
# loop; a restart file every restart_every steps.
pair_coeff 1 2 ${epsilon12} ${sig12} ${cutoff12}

fix F_langevin all langevin 1 1 1 ${randseed} scale 4 ${scale4} tally yes
fix F_nve all nve
fix F_recenter dna recenter 0.0 0.0 0.0 shift all units box

timestep 0.005
dump D_nucleoid nucleoid atom 5000 ${simname}.ring.nucleoid.lammpstrj
dump_modify D_nucleoid scale no

variable fname string input.lmp
variable j loop ${n_loops} pad
    label dump_loop
    dump D_all all atom 10000 ${simname}.j${j}.ring.all.lammpstrj.gz
    dump_modify D_all scale no pad 2
    restart ${restart_every} ./restarts/restart.${i}
    run ${loop_steps}
    undump D_all
    next j
    jump ${fname} dump_loop

undump D_nucleoid
write_data ${simname}.ring.all.data pair ij
write_restart ./restart_after.i${i}
unfix F_nve
unfix F_langevin
unfix F_recenter
