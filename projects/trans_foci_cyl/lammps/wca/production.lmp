# TransFociCyl, variant wca: a ring of small and large monomers among
# crowders in a cylinder that is periodic along its axis, in Lennard-Jones
# units, with a Langevin thermostat. The pair potential is the 12-6
# Lennard-Jones potential cut at its minimum, 2^(1/6) sigma_ij, so only its
# repulsive part acts; the wall repels every particle the same way.
#
# This input reads the relaxed chain (the one minimize.lmp relaxed in the
# run's folder, or the shared one of ../start/), adds the crowders,
# equilibrates for 5e6 steps, and runs 20 production loops of 5e6 steps.
#
# The run's folder holds this file as input.lmp (the production loop jumps
# back into it by that name), minimized.initial.config.data, and an empty
# restarts/ folder. The sweep generator writes the run's variables at the top
# of input.lmp, from its row of SWEEP in study.conf:
#   sig2, n_big, mass2, n_small, epsilon_small, epsilon_big, r, lz, sig3,
#   n_crowd, i, randseed, run_dt, bug_dump, all_dump, neigh_style,
#   neigh_skin, eq1_dt, restart_every, grid_x, grid_y
#
# Atom types: 1 small monomer, 2 large monomer, 3 crowder.

#---------- Run lengths ----------
# Index variables holding the production values. A test shortens them
# with -var on the command line (for example -var loop_steps 1000);
# LAMMPS never redefines an index variable. The loop pads j to the width
# of n_loops: 20 loops give j01, j02, ..., j20. The sweep generator writes
# the run's own restart_every before this default.
variable eq1_steps index 1000000
variable eq2_steps index 4000000
variable n_loops index 20
variable loop_steps index 5000000
variable restart_every index 1000000

#---------- Sizes and pair cutoffs ----------
# sigma_ij = (sigma_i + sigma_j) / 2
variable sig1 equal 1.0
variable sig12 equal (${sig1}+${sig2})/2
variable sig13 equal (${sig1}+${sig3})/2
variable sig23 equal (${sig2}+${sig3})/2

# r_cut_ij = lj_rcut sigma_ij, with lj_rcut = 2^(1/6)
variable lj_rcut equal 1.12246205
variable cutoff11 equal ${sig1}*${lj_rcut}
variable cutoff12 equal ((${sig1}+${sig2})/2.0)*${lj_rcut}
variable cutoff13 equal ((${sig1}+${sig3})/2.0)*${lj_rcut}
variable cutoff22 equal ${sig2}*${lj_rcut}
variable cutoff23 equal ((${sig2}+${sig3})/2.0)*${lj_rcut}
variable cutoff33 equal ${sig3}*${lj_rcut}

variable run_name string epss${epsilon_small}epsl${epsilon_big}r${r}al${sig2}nl${n_big}ml${mass2}ns${n_small}ac${sig3}nc${n_crowd}lz${lz}dt${run_dt}bdump${bug_dump}adump${all_dump}ens${i}

#---------- Initialization ----------
units lj
dimension 3
boundary f f p
atom_style bond

# The run's row sets the number of domains across the cylinder: grid_x by
# grid_y, with any number along its axis.
processors ${grid_x} ${grid_y} *

read_data minimized.initial.config.data nocoeff

#---------- Neighbor lists ----------
# The run's row names the style. bin: one bin size for all atom types.
# multi: a bin size and a ghost cutoff (pair cutoff plus skin) per atom
# type, for the large size ratio of small monomers, large monomers, and
# crowders.
neighbor ${neigh_skin} ${neigh_style}
neigh_modify delay 0 every 1 check yes
variable gRcut1 equal ${cutoff11}+${neigh_skin}
variable gRcut2 equal ${cutoff22}+${neigh_skin}
variable gRcut3 equal ${cutoff33}+${neigh_skin}
if "${neigh_style} == multi" then &
    "neigh_modify collection/type 3 1 2 3" &
    "comm_modify mode multi cutoff/multi 1 ${gRcut1} cutoff/multi 2 ${gRcut2} cutoff/multi 3 ${gRcut3}"

#---------- Cylinder and crowders ----------
# Fixed in x and y, periodic along z, the axis; the wall is the cylinder of
# radius r around the axis. The crowders are placed at random inside it.
change_box all x final -${r} ${r} y final -${r} ${r} z final -${lz} ${lz} boundary f f p units box
region cylshell cylinder z 0.0 0.0 ${r} INF INF units box
create_atoms 3 random ${n_crowd} ${randseed} cylshell units box

group bug_small type 1
group bug_big type 2
group bug type 1 2
group crowd type 3

mass 1 1.0
mass 2 ${mass2}
mass 3 1.0

compute mobile bug temp

#---------- Pair potential among all particles ----------
# lj/cut with epsilon = 1, sigma_ij as above, and the cutoff r_cut_ij at the
# minimum of the 12-6 potential: the forces are those of the
# Weeks-Chandler-Andersen potential. The energy is not shifted.
pair_style lj/cut ${lj_rcut}
pair_coeff 1 1 1.0 ${sig1} ${cutoff11}
pair_coeff 1 2 1.0 ${sig12} ${cutoff12}
pair_coeff 1 3 1.0 ${sig13} ${cutoff13}
pair_coeff 2 2 1.0 ${sig2} ${cutoff22}
pair_coeff 2 3 1.0 ${sig23} ${cutoff23}
pair_coeff 3 3 1.0 ${sig3} ${cutoff33}

#---------- FENE bonds along the ring ----------
# K_ij = 30 epsilon / sigma_ij^2 and R0_ij = 1.5 sigma_ij, with epsilon = 1
# and sigma_11 = 1; bond type 1 joins two small monomers, type 2 a small
# and a large one. special_bonds fene turns the pair potential off between
# bonded monomers; the FENE bond carries its own repulsion.
bond_style fene
variable sig11fene equal 1.5*${sig1}
variable sig12fene equal 1.5*${sig1}*(${sig12}/${sig1})
variable k11fene equal 30/(${sig1}*${sig1})
variable k12fene equal (30/(${sig1}*${sig1}))*((${sig1}/${sig12})^2)
bond_coeff 1 ${k11fene} ${sig11fene} 1.0 ${sig1}
bond_coeff 2 ${k12fene} ${sig12fene} 1.0 ${sig12}
special_bonds fene

#---------- Langevin thermostat and wall ----------
# T = 1, damping time 10, for every particle, from here to the end of
# production. The wall repels each species with the 12-6 Lennard-Jones
# potential of its size, cut at its minimum; its strength is epsilon_small
# for the small monomers, epsilon_big for the large ones, and 1 for the
# crowders.
fix F_langevin all langevin 1.0 1.0 10.0 ${randseed}
fix F_wall_small bug_small wall/region cylshell lj126 ${epsilon_small} ${sig1} ${cutoff11}
fix F_wall_big bug_big wall/region cylshell lj126 ${epsilon_big} ${sig12} ${cutoff12}
fix F_wall_crowd crowd wall/region cylshell lj126 1.0 ${sig13} ${cutoff13}

#---------- Equilibration, stage 1 ----------
# eq1_steps steps (1e6) with displacements capped at 0.01 per step, which
# pushes overlapping crowders apart. The run's row sets the timestep,
# eq1_dt. The chain's center of mass is kept at z = 0.
fix F_nve all nve/limit 0.01
fix F_recenter bug recenter NULL NULL 0.0 shift all units box
thermo 10000
thermo_style multi
timestep ${eq1_dt}
run ${eq1_steps}
write_restart ./restart_before.i${i}.part1
unfix F_nve
unfix F_recenter

#---------- Equilibration, stage 2 ----------
# eq2_steps steps (4e6) of plain integration.
fix F_nve all nve
fix F_recenter bug recenter NULL NULL 0.0 shift all units box
thermo 10000
thermo_style multi
timestep 0.01
run ${eq2_steps}
write_restart ./restart_before.i${i}.part2
unfix F_nve
unfix F_recenter

#---------- Production ----------
# n_loops loops of loop_steps steps. The chain is written every bug_dump
# steps to one file; all particles every all_dump steps, to one gzipped file
# per loop; a restart file every restart_every steps.
fix F_nve all nve
fix F_recenter bug recenter NULL NULL 0.0 shift all units box
timestep ${run_dt}

dump D_bug bug atom ${bug_dump} ${run_name}.ring.bug.lammpstrj
dump_modify D_bug scale no

variable fname string input.lmp
variable j loop ${n_loops} pad
    label dump_loop
    dump D_all all atom ${all_dump} ${run_name}.j${j}.ring.all.lammpstrj.gz
    dump_modify D_all scale no pad 2
    restart ${restart_every} ./restarts/restart.${i}
    run ${loop_steps}
    undump D_all
    next j
    jump ${fname} dump_loop
undump D_bug
write_data ${run_name}.ring.all.data pair ij
write_restart ./restart_after.i${i}
